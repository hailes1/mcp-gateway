{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MCP Gateway: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8080"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": true
    }
  ]
}
